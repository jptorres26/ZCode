# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# Production address reference. Copy to .env as needed; deployment overrides can also go in the untracked .env.local.
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# 线上公开 OAuth client id，不是 secret。
# Public production OAuth client id; not a secret.
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# Back-link base for imported sessions; does not change the API. Keep /cn/share, without the share code.
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
# When changing the API origin, change this too, or delete the line to follow the API origin automatically; never set it to an empty value.
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
# Full override URL for remote assets; must include the version number matching the running build. Delete the line to derive it from the version automatically.
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
# Optional path to a local provider config file; leave empty to use the built-in production config.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
# Intranet or private deployment addresses have no production defaults; fill them in explicitly as needed.
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
